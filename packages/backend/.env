# ============================================================================
# MAGS AI STUDIO - BACKEND ENVIRONMENT CONFIGURATION (Development)
# ============================================================================

# ============ APPLICATION ============
NODE_ENV=development
APP_VERSION=1.0.0
APP_NAME=MAGS-AI-Studio
API_PORT=3001
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# ============ DATABASE ============
DATABASE_URL="postgresql://mags:password123@localhost:5432/mags_db"
DB_HOST=localhost
DB_PORT=5432
DB_USER=mags
DB_PASSWORD=password123
DB_NAME=mags_db
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000

# ============ REDIS ============
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_TTL=3600

# ============ JWT & SECURITY ============
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_REFRESH_EXPIRATION=30d
SESSION_ROTATION_INTERVAL=900000
ENCRYPTION_KEY=your-encryption-key-change-in-production
ENCRYPTION_SALT=your-salt-change-in-production

# ============ RATE LIMITING ============
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_AUTH_WINDOW_MS=300000
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX_REQUESTS=500

# ============ SECURITY ============
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_WINDOW=300
BRUTE_FORCE_BLOCK_DURATION=900
MAX_CONCURRENT_SESSIONS=5
SESSION_TIMEOUT=1800
ANOMELY_THRESHOLD=0.7
CONFIDENCE_THRESHOLD=0.8

# ============ CORS & HEADERS ============
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ============ LOGGING ============
LOG_LEVEL=debug
LOG_FORMAT=simple
LOG_SERVICE=mags-backend
LOG_ENVIRONMENT=development

# ============ EMAIL & NOTIFICATIONS ============
SENDGRID_API_KEY=""
SENDGRID_FROM=noreply@mags-ai.com
NOTIFICATION_QUEUE_ENABLED=true

# ============ STRIPE (BILLING) ============
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
BILLING_CURRENCY=USD
BILLING_TAX_RATE=0.10

# ============ EXTERNAL SERVICES ============
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4-turbo
ANTHROPIC_API_KEY=""

# ============ CDN & STORAGE ============
CDN_URL=http://localhost:3001/cdn
CDN_API_KEY=""
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# ============ DEPLOYMENT & DEVOPS ============
DEVOPS_REDIS_HOST=localhost
DEVOPS_REDIS_PORT=6379
DEPLOYMENT_TIMEOUT=3600000
DEPLOYMENT_HEALTH_CHECK_INTERVAL=300000
AUTO_ROLLBACK_ON_FAILURE=true
ROLLBACK_WAIT_TIME=300000
ZERO_DOWNTIME_DEPLOYMENT=false

# ============ DOCKER CONFIGURATION ============
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=""
DOCKER_PASSWORD=""
DOCKER_NAMESPACE=""

# ============ KUBERNETES CONFIGURATION ============
K8S_API_URL=https://kubernetes.cluster
K8S_TOKEN=""
K8S_NAMESPACE=default
KUBERNETES_NAMESPACE=default
KUBERNETES_CLUSTERS='{"local":"/etc/kubernetes/config"}'

# ============ INFRASTRUCTURE ============
INFRASTRUCTURE_REDIS_HOST=localhost
INFRASTRUCTURE_REDIS_PORT=6379
MIN_NODES_PER_CLUSTER=1
MAX_NODES_PER_CLUSTER=10
DEFAULT_NODE_TYPE=t3.medium
HEALTH_CHECK_INTERVAL_SECONDS=60
SCALING_EVAL_INTERVAL_SECONDS=60

# ============ AWS CONFIGURATION ============
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
EKS_CLUSTER_ROLE_ARN=""
EKS_NODE_ROLE_ARN=""

# ============ GCP CONFIGURATION ============
GCP_PROJECT_ID=""
GCP_CREDENTIALS_PATH=""

# ============ AZURE CONFIGURATION ============
AZURE_SUBSCRIPTION_ID=""
AZURE_RESOURCE_GROUP=""

# ============ MONITORING & OBSERVABILITY ============
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
SENTRY_DSN=""
ELASTICSEARCH_URL=http://localhost:9200
MONITORING_INTERVAL=60000
UPTIME_CHECK_INTERVAL=300000

# ============ ANALYTICS ============
ANALYTICS_REDIS_HOST=localhost
ANALYTICS_REDIS_PORT=6379
ANALYTICS_WS_URL=ws://localhost:3001/analytics
EVENT_BATCH_SIZE=100
EVENT_BATCH_TIMEOUT=5000
METRICS_FLUSH_INTERVAL=60000
AI_USAGE_TRACKING_ENABLED=true

# ============ COLLABORATION ============
COLLABORATION_REDIS_HOST=localhost
COLLABORATION_REDIS_PORT=6379
WEBSOCKET_ORIGIN=http://localhost:3000
WEBSOCKET_NAMESPACE=/collaboration
WEBSOCKET_RECONNECT_INTERVAL=5000
PRESENCE_TIMEOUT_MINUTES=2
PRESENCE_UPDATE_INTERVAL=30000

# ============ COMPLIANCE & AUDIT ============
AUDIT_LOG_RETENTION=2555
GDPR_DATA_EXPORT_ENABLED=true
GDPR_DATA_DELETION_ENABLED=true
CCPA_ENABLED=false
DELETION_GRACE_PERIOD=30

# ============ FEATURE FLAGS ============
FEATURE_AI_GENERATION=true
FEATURE_DEPLOYMENT=true
FEATURE_COLLABORATION=true
FEATURE_BILLING=false
FEATURE_ANALYTICS=true
